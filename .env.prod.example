# prod 환경 환경변수 — .env.prod 로 복사 후 값 채우기 (절대 커밋 금지)
DB_URL=jdbc:mysql://<RDS_ENDPOINT>:3306/green_prod?useSSL=true&serverTimezone=Asia/Seoul
DB_USERNAME=admin
DB_PASSWORD=<RDS_PASSWORD>
JPA_DDL_AUTO=validate
JWT_SECRET=<64자_이상_랜덤_시크릿>
ADMIN_INIT_LOGIN_ID=admin
ADMIN_INIT_PASSWORD=<관리자_초기_비밀번호>
S3_BUCKET=green-link-photos-prod-2026
S3_REGION=ap-northeast-2
ALIGO_KEY=<알리고_API_KEY>
ALIGO_USERID=<알리고_USER_ID>
ALIGO_SENDER=1855-4400
PORTAL_BASE_URL=https://admin.onurim.com
